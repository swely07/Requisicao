rules_version = '2';
service cloud.firestore {
 match /databases/{database}/documents {
  function valid(){return request.auth != null && request.auth.token.email_verified == true && request.auth.token.email.matches('.*@ebjc[.]pt$');}
  function admin(){return valid() && exists(/databases/$(database)/documents/admins/$(request.auth.uid));}
  match /admins/{uid}{allow get: if valid() && request.auth.uid == uid; allow list,write: if false;}
  match /equipamentos/{id}{allow read: if valid(); allow create,update: if admin() && request.resource.data.keys().hasOnly(['nome','quantidade','disponivel']) && request.resource.data.nome is string && request.resource.data.quantidade is int && request.resource.data.disponivel is int && request.resource.data.disponivel >= 0 && request.resource.data.disponivel <= request.resource.data.quantidade;}
  match /requisicoes/{id}{
   allow read: if valid() && (admin() || resource.data.uid == request.auth.uid);
   allow create: if valid() && request.resource.data.keys().hasOnly(['codigo','uid','email','requisitante','equipamento','equipamentoId','dataPedido','devolucaoPrevista','observacoes','estado','criadoEm']) && request.resource.data.uid == request.auth.uid && request.resource.data.email == request.auth.token.email && request.resource.data.estado == 'Pendente' && request.resource.data.criadoEm == request.time && request.resource.data.observacoes is string && request.resource.data.observacoes.size() <= 500 && request.resource.data.dataPedido.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.devolucaoPrevista.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}') && request.resource.data.devolucaoPrevista >= request.resource.data.dataPedido && exists(/databases/$(database)/documents/equipamentos/$(request.resource.data.equipamentoId)) && request.resource.data.equipamento == get(/databases/$(database)/documents/equipamentos/$(request.resource.data.equipamentoId)).data.nome;
   allow update: if admin() && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['estado','atualizadoEm']) && request.resource.data.atualizadoEm == request.time && ((resource.data.estado == 'Pendente' && request.resource.data.estado in ['Aprovado','Recusado']) || (resource.data.estado == 'Aprovado' && request.resource.data.estado == 'Em empréstimo') || (resource.data.estado == 'Em empréstimo' && request.resource.data.estado == 'Devolvido'));
  }
 }
}
